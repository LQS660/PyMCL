<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!--
            覆盖系统主题笔刷必须放进 ThemeDictionaries，否则一份定义会被三种主题共用：
            浅色下合适的深绿 #1E7A52 压到深色背景上对比度不足，而高对比度模式下
            用户特意选的配色会被我们的绿色直接盖掉（可访问性问题）。
        -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#2E9B6B"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#3EAA7A"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#5BC090"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#1E7A52"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#2E9B6B"/>
            <SolidColorBrush x:Key="PclGreen" Color="#2E9B6B"/>
            <SolidColorBrush x:Key="PclGreenText" Color="#1B7A54"/>
            <SolidColorBrush x:Key="PclDivider" Color="#EEF3F7"/>
            <SolidColorBrush x:Key="PclAiUserBubble" Color="#E8F6EF"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <!-- 深色下整体提亮一档，保证文字/指示器压在深背景上仍然看得清。 -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3EAA7A"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#4CB887"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6FCAA0"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#6FCAA0"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#4CB887"/>
            <SolidColorBrush x:Key="PclGreen" Color="#4CB887"/>
            <SolidColorBrush x:Key="PclGreenText" Color="#7FD4AC"/>
            <SolidColorBrush x:Key="PclDivider" Color="#2A3038"/>
            <SolidColorBrush x:Key="PclAiUserBubble" Color="#1B3A2C"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <!-- 高对比度下一律让位给系统配色，不要强推品牌绿。 -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="PclGreen" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="PclGreenText" Color="{ThemeResource SystemColorHotlightColor}"/>
            <SolidColorBrush x:Key="PclDivider" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="PclAiUserBubble" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 调色板本身与主题无关，系统据此派生各种变体。 -->
    <Color x:Key="SystemAccentColor">#2E9B6B</Color>
    <Color x:Key="SystemAccentColorLight1">#4CB887</Color>
    <Color x:Key="SystemAccentColorLight2">#6FCAA0</Color>
    <Color x:Key="SystemAccentColorLight3">#A6E0C6</Color>
    <Color x:Key="SystemAccentColorDark1">#1E7A52</Color>
    <Color x:Key="SystemAccentColorDark2">#166241</Color>
    <Color x:Key="SystemAccentColorDark3">#0E4630</Color>

    <Style x:Key="FluentCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
</ResourceDictionary>
