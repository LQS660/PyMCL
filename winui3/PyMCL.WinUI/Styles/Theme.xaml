<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!--
            新视觉：海石蓝（Ocean Slate），刻意告别旧 PCL 绿 #2E9B6B。
            C 桥 + 外置 WinUI，主题不进 native exe。
        -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0B6E99"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#1A86B5"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#3AA0C8"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#084F6F"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#0B6E99"/>
            <SolidColorBrush x:Key="PclGreen" Color="#0B6E99"/>
            <SolidColorBrush x:Key="PclGreenText" Color="#084F6F"/>
            <SolidColorBrush x:Key="PclDivider" Color="#E8EEF3"/>
            <SolidColorBrush x:Key="PclAiUserBubble" Color="#E3F2F8"/>
            <SolidColorBrush x:Key="ShellPaneBrush" Color="#F3F7FA"/>
            <SolidColorBrush x:Key="ShellTitleBrush" Color="#F8FBFD"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#3AA0C8"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#5BB4D4"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#7EC8E0"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#7EC8E0"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#5BB4D4"/>
            <SolidColorBrush x:Key="PclGreen" Color="#5BB4D4"/>
            <SolidColorBrush x:Key="PclGreenText" Color="#9AD6EA"/>
            <SolidColorBrush x:Key="PclDivider" Color="#243039"/>
            <SolidColorBrush x:Key="PclAiUserBubble" Color="#163645"/>
            <SolidColorBrush x:Key="ShellPaneBrush" Color="#141A1F"/>
            <SolidColorBrush x:Key="ShellTitleBrush" Color="#10151A"/>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource SystemColorHotlightColor}"/>
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="PclGreen" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="PclGreenText" Color="{ThemeResource SystemColorHotlightColor}"/>
            <SolidColorBrush x:Key="PclDivider" Color="{ThemeResource SystemColorWindowTextColor}"/>
            <SolidColorBrush x:Key="PclAiUserBubble" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="ShellPaneBrush" Color="{ThemeResource SystemColorWindowColor}"/>
            <SolidColorBrush x:Key="ShellTitleBrush" Color="{ThemeResource SystemColorWindowColor}"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="SystemAccentColor">#0B6E99</Color>
    <Color x:Key="SystemAccentColorLight1">#1A86B5</Color>
    <Color x:Key="SystemAccentColorLight2">#3AA0C8</Color>
    <Color x:Key="SystemAccentColorLight3">#7EC8E0</Color>
    <Color x:Key="SystemAccentColorDark1">#084F6F</Color>
    <Color x:Key="SystemAccentColorDark2">#063A52</Color>
    <Color x:Key="SystemAccentColorDark3">#042636</Color>

    <Style x:Key="FluentCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>
</ResourceDictionary>
