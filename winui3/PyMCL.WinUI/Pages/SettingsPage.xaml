<UserControl
    x:Class="PyMCL.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PageRoot" Padding="28,20" Spacing="16">
            <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}"/>

            <TextBlock Text="版本隔离与存储" FontWeight="SemiBold"/>
            <Border x:Name="CardStorage" Style="{StaticResource FluentCard}" Padding="16" Translation="0,0,16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Text="共享 libraries" VerticalAlignment="Center" Margin="0,0,120,0" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="ShareLibs" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="所有实例共享依赖库（节省空间，但会降低隔离性）" Foreground="#888888" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Text="共享 assets 资源" VerticalAlignment="Center" Margin="0,0,120,0" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="ShareAssets" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="所有实例共享资源文件（节省空间，但会降低隔离性）" Foreground="#888888" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="新版本默认隔离"/>
                        <ComboBox x:Name="IsoBox" HorizontalAlignment="Left" Width="260">
                            <ComboBoxItem Content="关闭（共用实例目录）" Tag="none"/>
                            <ComboBoxItem Content="隔离存档" Tag="saves"/>
                            <ComboBoxItem Content="隔离 Mod 与配置" Tag="mods"/>
                            <ComboBoxItem Content="隔离全部" Tag="all"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="默认 JVM 参数"/>
                        <TextBox x:Name="JvmEdit" PlaceholderText="-XX:+UseG1GC" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="下载与性能" FontWeight="SemiBold"/>
            <Border x:Name="CardPerf" Style="{StaticResource FluentCard}" Padding="16" Translation="0,0,16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="下载并发线程数"/>
                        <TextBlock Text="同时下载的文件数量" Foreground="#888888" FontSize="12" TextWrapping="Wrap"/>
                        <NumberBox x:Name="ThreadsSpin" Minimum="1" Maximum="64" Value="8" HorizontalAlignment="Left" Width="140" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="默认内存 (MB)"/>
                        <TextBlock Text="新实例的默认 JVM 内存" Foreground="#888888" FontSize="12" TextWrapping="Wrap"/>
                        <NumberBox x:Name="MemorySpin" Minimum="512" Maximum="32768" Value="4096" HorizontalAlignment="Left" Width="140" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="默认分辨率"/>
                        <TextBlock Text="游戏窗口的默认宽高" Foreground="#888888" FontSize="12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox x:Name="WidthSpin" Minimum="320" Maximum="7680" Value="854" Width="100" SpinButtonPlacementMode="Compact"/>
                            <TextBlock Text="×" VerticalAlignment="Center"/>
                            <NumberBox x:Name="HeightSpin" Minimum="240" Maximum="4320" Value="480" Width="100" SpinButtonPlacementMode="Compact"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="启动与下载" FontWeight="SemiBold"/>
            <Border x:Name="CardLaunch" Style="{StaticResource FluentCard}" Padding="16" Translation="0,0,16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="启动器可见性"/>
                        <ComboBox x:Name="VisBox" HorizontalAlignment="Left" Width="260">
                            <ComboBoxItem Content="保持显示" Tag="keep"/>
                            <ComboBoxItem Content="最小化" Tag="minimize"/>
                            <ComboBoxItem Content="隐藏" Tag="hide"/>
                            <ComboBoxItem Content="隐藏，退出后重开" Tag="hide_reopen"/>
                            <ComboBoxItem Content="关闭启动器" Tag="close"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="内存回收器"/>
                        <ComboBox x:Name="GcBox" HorizontalAlignment="Left" Width="260">
                            <ComboBoxItem Content="G1（推荐）" Tag="auto"/>
                            <ComboBoxItem Content="G1" Tag="g1"/>
                            <ComboBoxItem Content="调优 G1" Tag="g1_tuned"/>
                            <ComboBoxItem Content="ZGC" Tag="zgc"/>
                            <ComboBoxItem Content="不指定" Tag="none"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="下载限速 (KB/s)"/>
                        <TextBlock Text="0 表示不限制" Foreground="#888888" FontSize="12"/>
                        <NumberBox x:Name="LimitSpin" Minimum="0" Maximum="102400" Value="0" HorizontalAlignment="Left" Width="140" SpinButtonPlacementMode="Compact"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="启动页主页"/>
                        <ComboBox x:Name="HomeBox" HorizontalAlignment="Left" Width="260">
                            <ComboBoxItem Content="Minecraft 新闻" Tag="news"/>
                            <ComboBoxItem Content="本地 HTML" Tag="custom"/>
                            <ComboBoxItem Content="空白" Tag="blank"/>
                        </ComboBox>
                    </StackPanel>
                    <TextBox x:Name="HomePath" Header="自定义主页 HTML" PlaceholderText="本地 .html 路径"/>
                    <StackPanel Spacing="4">
                        <Grid>
                            <TextBlock Text="启动时检查更新" VerticalAlignment="Center" Margin="0,0,120,0" TextWrapping="Wrap"/>
                            <ToggleSwitch x:Name="AutoUpd" HorizontalAlignment="Right" IsOn="True"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="账号与下载源" FontWeight="SemiBold"/>
            <Border x:Name="CardAccount" Style="{StaticResource FluentCard}" Padding="16" Translation="0,0,16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="微软 OAuth 客户端 ID"/>
                        <TextBlock Text="一般无需修改" Foreground="#888888" FontSize="12" TextWrapping="Wrap"/>
                        <TextBox x:Name="MsClient" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="CurseForge API 密钥"/>
                        <TextBlock Text="可选；仅在国内镜像不可用时用于搜索兜底" Foreground="#888888" FontSize="12" TextWrapping="Wrap"/>
                        <PasswordBox x:Name="CurseKey" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="AI 助手" FontWeight="SemiBold"/>
            <Border x:Name="CardAi" Style="{StaticResource FluentCard}" Padding="16" Translation="0,0,16">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="接入方式"/>
                        <ComboBox x:Name="AiModeBox" HorizontalAlignment="Left" Width="220">
                            <ComboBoxItem Content="公益接口" Tag="public"/>
                            <ComboBoxItem Content="自定义 NewAPI" Tag="custom"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel x:Name="AiPublicPanel" Spacing="4">
                        <TextBlock Text="自建网关（可选）"/>
                        <TextBlock Text="一般留空，走内置公益接口" Foreground="#888888" FontSize="12" TextWrapping="Wrap"/>
                        <TextBox x:Name="AiGateway" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel x:Name="AiCustomPanel" Spacing="8" Visibility="Collapsed">
                        <TextBox x:Name="AiBase" Header="NewAPI Base URL" PlaceholderText="填到 /v1 为止"/>
                        <PasswordBox x:Name="AiKey" Header="NewAPI 令牌"/>
                        <TextBox x:Name="AiModel" Header="模型名"/>
                    </StackPanel>
                    <Button Content="测试 AI 连接" Click="TestAi_Click"/>
                </StackPanel>
            </Border>

            <Button Content="保存设置" Height="36" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="检查更新" Click="Update_Click"/>
                <Button Content="清理文件" Click="Clean_Click"/>
                <Button Content="全局 Mod" Click="GlobalMods_Click"/>
                <Button Content="帮助" Click="Help_Click"/>
            </StackPanel>
            <TextBlock x:Name="RootLabel" Foreground="#888888" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
