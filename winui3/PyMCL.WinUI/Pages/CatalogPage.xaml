<UserControl
    x:Class="PyMCL.Pages.CatalogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource FluentCard}" Padding="16,12,16,14" Margin="0,0,0,10" Translation="0,0,16">
            <StackPanel>
                <TextBlock x:Name="SearchTitle" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"/>
                <Grid Margin="0,10,0,10" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="InstanceBox" HorizontalAlignment="Stretch"/>
                    <Button x:Name="LinkBtn" Grid.Column="1" Click="Link_Click"/>
                    <Button x:Name="LocalBtn" Grid.Column="2" Click="Local_Click"/>
                </Grid>
                <TextBlock Text="名称" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="NameEdit" PlaceholderText="名称" KeyDown="Name_Key" HorizontalAlignment="Stretch"/>
                <Grid Margin="0,10,0,0" ColumnSpacing="10" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="来源" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SourceBox" HorizontalAlignment="Stretch">
                            <x:String>全部</x:String>
                            <x:String>Modrinth</x:String>
                            <x:String>CurseForge</x:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="版本" Foreground="#888888" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="VersionBox" HorizontalAlignment="Stretch" IsEditable="True">
                            <x:String>全部 (也可自行输入)</x:String>
                            <x:String>1.21.1</x:String>
                            <x:String>1.20.1</x:String>
                            <x:String>1.19.2</x:String>
                            <x:String>1.18.2</x:String>
                            <x:String>1.16.5</x:String>
                            <x:String>1.12.2</x:String>
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <TextBlock Text="类型" Foreground="#888888" FontSize="12" Margin="0,10,0,4"/>
                <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Spacing="12">
                    <Button Content="搜索" MinWidth="88" Height="32" Click="Search_Click"
                            Style="{StaticResource AccentButtonStyle}"/>
                    <Button Content="重置条件" MinWidth="88" Height="32" Click="Reset_Click"/>
                    <Button x:Name="InstalledBtn" Content="已安装" MinWidth="88" Height="32" Click="Installed_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource FluentCard}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ResultList" Padding="8,6"/>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
