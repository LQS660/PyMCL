<UserControl
    x:Class="PyMCL.Pages.ServersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="服务器列表" FontSize="20" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="实例" VerticalAlignment="Center" Opacity="0.7"/>
            <ComboBox x:Name="InstanceBox" Width="180" SelectionChanged="InstanceBox_SelectionChanged"/>
            <Button Content="添加服务器" Click="Add_Click" Style="{StaticResource AccentButtonStyle}"/>
            <Button Content="删除" Click="Delete_Click"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <ListView x:Name="ServerList" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="{Binding Ip}" Opacity="0.85"/>
                            <TextBlock Grid.Column="2" Text="{Binding Port}" HorizontalAlignment="Right" Opacity="0.7"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="Empty" Text="没有可用的服务器&#x0a;点击「添加服务器」开始添加"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" Opacity="0.6" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
