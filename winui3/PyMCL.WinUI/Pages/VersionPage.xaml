<UserControl
    x:Class="PyMCL.Pages.VersionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="Page_SizeChanged">
    <Grid x:Name="PageRoot" Padding="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="版本" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14"/>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" PlaceholderText="搜索版本号…" TextChanged="Filter_Changed" HorizontalAlignment="Stretch"/>
            <RadioButtons x:Name="TypePivot" MaxColumns="4" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <RadioButton Content="全部" Tag="all"/>
                <RadioButton Content="正式版" Tag="release"/>
                <RadioButton Content="快照" Tag="snapshot"/>
                <RadioButton Content="远古" Tag="old_alpha"/>
            </RadioButtons>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="实例" VerticalAlignment="Center"/>
                <ComboBox x:Name="InstanceBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="Instance_Changed"/>
                <TextBlock Grid.Column="2" Text="加载器" VerticalAlignment="Center"/>
                <ComboBox x:Name="LoaderBox" Grid.Column="3" HorizontalAlignment="Stretch">
                    <x:String>无</x:String>
                    <x:String>Fabric</x:String>
                    <x:String>Forge</x:String>
                    <x:String>Quilt</x:String>
                    <x:String>NeoForge</x:String>
                    <x:String>OptiFine</x:String>
                    <x:String>LiteLoader</x:String>
                </ComboBox>
            </Grid>
        </StackPanel>
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <ItemsRepeater x:Name="VersionGrid">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="200" MinItemHeight="132" MinColumnSpacing="12" MinRowSpacing="12"
                                       ItemsStretch="Fill"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
        <Border Grid.Row="3" Style="{StaticResource FluentCard}" Padding="20,14" Margin="0,12,0,0" Translation="0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="已安装版本" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,168,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="修复选中" Click="Repair_Click" Background="Transparent" BorderThickness="0"/>
                        <Button Content="卸载选中" Click="Uninstall_Click" Background="Transparent" BorderThickness="0"/>
                    </StackPanel>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,8,0,0">
                    <StackPanel x:Name="InstalledList"/>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
